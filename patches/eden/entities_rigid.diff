+    # Genesis v1.4.1 dropped the relative set_mass_shift/set_COM_shift in favour of absolute
+    # set_links_mass/set_links_COM. The shims below keep the "shift from the unshifted value" semantics:
+    # nominal values are captured on first use, so repeated resets do not accumulate shifts.
+    def _nominal_links_prop(self, name, getter):
+        cache = self.__dict__.setdefault("_nominal_links_cache", {})
+        if name not in cache:
+            val = getter(None, None).clone()
+            batched = val.ndim == (2 if name == "mass" else 3)
+            if not batched:
+                val = val.unsqueeze(0).expand(max(self._env.num_envs, 1), *val.shape).clone()
+            cache[name] = (val, batched)
+        return cache[name]
+
+    def _set_links_shifted(self, name, shift, ls_idx_local, envs_idx, getter, setter):
+        nominal, batched = self._nominal_links_prop(name, getter)
+        ls = torch.as_tensor(ls_idx_local, device=nominal.device).long()
+        if envs_idx is None:
+            envs_idx = slice(None)
+        value = nominal[:, ls][envs_idx] + shift
+        if batched:
+            setter(value, ls, envs_idx)
+        else:
+            if self._env.num_envs > 1:
+                raise RuntimeError("per-env mass/COM randomization needs RigidOptions.batch_links_info=True")
+            setter(value[0], ls, None)
+
+    def get_links_inertial_mass(self, ls_idx_local=None, envs_idx=None):
+        """Unshifted per-link mass, shape (num_envs, n_links)."""
+        nominal, _ = self._nominal_links_prop("mass", self._entity.get_links_mass)
+        if ls_idx_local is not None:
+            nominal = nominal[:, torch.as_tensor(ls_idx_local, device=nominal.device).long()]
+        return nominal if envs_idx is None else nominal[envs_idx]
+
